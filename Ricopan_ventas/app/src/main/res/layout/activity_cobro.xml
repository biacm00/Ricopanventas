<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAF8F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TÍTULO DE LA PANTALLA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Módulo de Cobro"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#8B4513"
                android:letterSpacing="0.02"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccione método de pago y registre el efectivo"
                android:textSize="13sp"
                android:textColor="#777777"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- TARJETA DE RESUMEN DE PAGO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL A PAGAR"
                        android:textColor="#8B4513"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/tvTotalCobro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S/. 0.00"
                        android:textColor="#222222"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA MÉTODO DE PAGO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MÉTODO DE PAGO"
                    android:textColor="#8B4513"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="14dp"/>

                <RadioGroup
                    android:id="@+id/rgMetodoPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbEfectivo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💵 Efectivo"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/rbYape"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:text="📱 Yape / Plin"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA INGRESO EFECTIVO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/llProcesamientoEfectivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INGRESO DE EFECTIVO"
                    android:textColor="#8B4513"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etMontoRecibido"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Ingrese monto recibido (S/.)"
                    android:textColor="#222222"
                    android:textColorHint="#888888"
                    android:inputType="numberDecimal"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:textSize="16sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BOTÓN CONFIRMAR VENTA -->
        <Button
            android:id="@+id/btnConfirmarVenta"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Confirmar y Generar Ticket"
            android:backgroundTint="#2E7D32"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="17sp"
            app:cornerRadius="14dp"
            android:elevation="6dp"/>

    </LinearLayout>
</ScrollView>