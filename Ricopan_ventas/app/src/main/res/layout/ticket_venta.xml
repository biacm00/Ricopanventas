<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- ICONO DE ÉXITO -->
    <TextView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:text="✅"
        android:textSize="32sp"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- ENCABEZADO BAKERY -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Panadería Pastelería"
        android:textAlignment="center"
        android:textSize="14sp"
        android:textColor="#8B4513"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RICO PAN"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#8B4513"
        android:letterSpacing="0.05"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comprobante de Venta Digital"
        android:textAlignment="center"
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desarrollado por Bianca Chamba Minguillo\ny Mailyn Oversluijs Paredes"
        android:textAlignment="center"
        android:textSize="10sp"
        android:textColor="#888888"
        android:layout_marginBottom="16dp"/>

    <!-- LÍNEA DIVISORIA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#DDDDDD"
        android:layout_marginBottom="14dp"/>

    <!-- DATOS DEL TICKET -->
    <TextView
        android:id="@+id/tvTicketDetalles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ticket N°: #TKT-00002\nFecha y Hora: 25/11/2026 06:11:37\nTurno: Turno 1: Mañana\nCajero: Vendedor / Cajero"
        android:lineSpacingExtra="5dp"
        android:layout_marginBottom="12dp"
        android:textSize="13sp"
        android:textColor="#333333"
        android:fontFamily="monospace"/>

    <!-- DETALLE DE PRODUCTOS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DETALLE DE PRODUCTOS"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#8B4513"
        android:letterSpacing="0.05"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvTicketProductos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Producto de ejemplo (S/. 0.00)"
        android:textSize="12sp"
        android:textColor="#444444"
        android:fontFamily="monospace"
        android:layout_marginBottom="12dp"/>

    <!-- LÍNEA DIVISORIA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#DDDDDD"
        android:layout_marginBottom="12dp"/>

    <!-- TOTALES Y MEDIO DE PAGO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TOTAL A PAGAR:"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#8B4513"/>

        <TextView
            android:id="@+id/tvTicketTotalMonto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S/. 7.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#8B4513"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTicketMetodoPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Medio de Pago: EFECTIVO"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡Gracias por su compra en Rico Pan!\nConserve este ticket para cualquier consulta."
        android:textAlignment="center"
        android:textSize="11sp"
        android:textColor="#777777"
        android:layout_marginBottom="20dp"/>

    <!-- BOTONES DEL TICKET -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCompartirTicket"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Imprimir / Compartir"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#FFFFFF"
            android:textColor="#8B4513"
            android:layout_marginEnd="8dp"
            app:cornerRadius="12dp"
            android:elevation="2dp"/>

        <Button
            android:id="@+id/btnCerrarTicket"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Nueva Venta"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#8B4513"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"
            android:elevation="2dp"/>
    </LinearLayout>

</LinearLayout>