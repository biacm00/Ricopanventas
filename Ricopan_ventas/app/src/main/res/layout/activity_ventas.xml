<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5">

    <!-- CABECERA CON GRADIENTE PREMIUM E IDENTIDAD DE MARCA (Idéntica al Login) -->
    <View
        android:id="@+id/viewHeaderBg"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_header_gradient" />

    <LinearLayout
        android:id="@+id/llHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp">

        <!-- TÍTULO, LOGO Y BOTÓN CERRAR SESIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/logo_real_rico_pan"
                android:scaleType="fitCenter"
                android:layout_marginEnd="12dp"
                android:contentDescription="Logo Rico Pan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloRol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RICO PAN - Vendedor"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:letterSpacing="0.03"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Panadería &amp; Pastelería Artesanal"
                    android:textSize="11sp"
                    android:textColor="#E0C3AD"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Salir"
                android:textSize="12sp"
                android:backgroundTint="#C62828"
                android:textColor="@android:color/white"
                app:cornerRadius="10dp"
                android:elevation="4dp"/>
        </LinearLayout>

        <!-- BUSCADOR ESTILIZADO -->
        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_field"
            android:hint="🔍  Buscar producto por nombre o código..."
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:elevation="6dp"/>

        <!-- FILTROS POR CATEGORÍA (Pills Modernos) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFiltroTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="✨ Todos"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#8B4513"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroPanaderia"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🥖 Panadería"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroPasteleria"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🍰 Bocaditos"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroAbarrotes"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🥤 Bebidas"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroCafes"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="☕ Cafés"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroEmbutidos"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🌭 Embutidos"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroLacteos"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🧀 Lácteos"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    app:cornerRadius="18dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- PANEL EXCLUSIVO PARA ADMINISTRADOR (Oculto en layout principal, usado internamente) -->
        <LinearLayout
            android:id="@+id/llAdminPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAgregarProducto"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnImportarExcel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnCierreCaja"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>

    <!-- LISTA DE PRODUCTOS (RecyclerView con soporte Drag and Drop) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewProductos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llHeaderContainer"
        android:layout_above="@id/llBottomCart"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

    <!-- BARRA INFERIOR DEL CARRITO FLOTANTE (Vendedor) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/llBottomCart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardBackgroundColor="#2E231F"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingVertical="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/layoutVerCarrito"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="TOTAL A PAGAR (VER CARRITO)"
                    android:textColor="#D7CCC8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="S/. 0.00"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLimpiarCarrito"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#C62828"
                android:text="Limpiar"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                app:cornerRadius="12dp"/>

            <Button
                android:id="@+id/btnCobrar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#2E7D32"
                android:text="Cobrar"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- BARRA INFERIOR DE NAVEGACIÓN ADMINISTRADOR (Tipo Botones Estilo Imagen de Referencia) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/llAdminBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardBackgroundColor="#2E231F"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnAdminAdd"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#FF9800"
                android:text="➕ Producto"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="12dp"/>

            <Button
                android:id="@+id/btnAdminExcel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:backgroundTint="#2E7D32"
                android:text="📥 Excel"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="12dp"/>

            <Button
                android:id="@+id/btnAdminCierre"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#1976D2"
                android:text="📊 Reportes"
                android:textStyle="bold"
                android:textSize="12sp"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>