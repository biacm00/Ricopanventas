<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5">

    <!-- CABECERA CON GRADIENTE PREMIUM (Igual al Login) -->
    <View
        android:id="@+id/viewHeaderBg"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_header_gradient" />

    <LinearLayout
        android:id="@+id/llHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- TÍTULO Y BOTÓN CERRAR SESIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvTituloRol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RICO PAN - Vendedor"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:letterSpacing="0.03"/>

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Cerrar Sesión"
                android:textSize="12sp"
                android:backgroundTint="#C62828"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"
                android:elevation="4dp"/>
        </LinearLayout>

        <!-- BUSCADOR ESTILIZADO -->
        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:hint="🔍  Buscar por nombre o código..."
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp"/>

        <!-- FILTROS POR CATEGORÍA (Pills) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFiltroTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="✨ Todos"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#8B4513"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroPanaderia"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🥖 Panadería"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroPasteleria"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🍰 Bocaditos"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroAbarrotes"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🥤 Bebidas"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroCafes"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="☕ Cafés"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroEmbutidos"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🌭 Embutidos"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="18dp"/>

                <Button
                    android:id="@+id/btnFiltroLacteos"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🧀 Lácteos"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    app:cornerRadius="18dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- PANEL EXCLUSIVO PARA ADMINISTRADOR -->
        <LinearLayout
            android:id="@+id/llAdminPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAgregarProducto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="+ Producto"
                android:backgroundTint="#FF9800"
                android:textColor="@android:color/white"
                android:layout_marginEnd="6dp"
                app:cornerRadius="12dp"/>

            <Button
                android:id="@+id/btnImportarExcel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="Cargar Excel"
                android:backgroundTint="#2E7D32"
                android:textColor="@android:color/white"
                android:layout_marginEnd="6dp"
                app:cornerRadius="12dp"/>

            <Button
                android:id="@+id/btnCierreCaja"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="Cierre Final"
                android:backgroundTint="#C62828"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- LISTA DE PRODUCTOS -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llHeaderContainer"
        android:layout_above="@id/llBottomCart"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/llListaProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        </LinearLayout>
    </ScrollView>

    <!-- BARRA INFERIOR DEL CARRITO FLOTANTE -->
    <androidx.cardview.widget.CardView
        android:id="@+id/llBottomCart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardBackgroundColor="#2E231F"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingVertical="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/layoutVerCarrito"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL A PAGAR"
                    android:textColor="#D7CCC8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/. 0.00"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="26sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnLimpiarCarrito"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#C62828"
                android:text="Limpiar"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                app:cornerRadius="12dp"/>

            <Button
                android:id="@+id/btnCobrar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#2E7D32"
                android:text="Cobrar"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>